        "skills/ctx-insight",
        "skills/ctx-insight/**",
        "skills/ctx-purge",
        "skills/ctx-purge/**",
        "skills/ctx-stats",
        "skills/ctx-stats/**",
        "skills/ctx-upgrade",
        "skills/ctx-upgrade/**"
      ]
    },
    "git:https://github.com/hasit/pi-community-themes",
    {
      "source": "git:https://github.com/mattpocock/skills.git",
